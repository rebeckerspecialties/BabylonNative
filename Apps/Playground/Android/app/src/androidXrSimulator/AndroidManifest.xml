<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker" />
        <provider android:authorities="org.khronos.openxr.system_runtime_broker" />
    </queries>

    <uses-feature
        android:name="android.software.xr.api.spatial"
        android:required="true" />

    <!-- Jetpack XR's runtime checks query the OpenXR runtime broker; these are normal permissions on Android XR. -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <application tools:node="merge">

        <!-- Replace the main launcher with the XR immersive activity. -->
        <activity
            android:name="PlaygroundActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize"
            tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="file"
                    android:host="*" />
                <data android:pathPattern=".*\\.glb" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.glb" />
            </intent-filter>
        </activity>

        <activity
            android:name="XrLauncherActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="XrImmersiveActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <!-- Start in full-space managed mode on Android XR. -->
            <property
                android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
                android:value="XR_ACTIVITY_START_MODE_FULL_SPACE_MANAGED" />
        </activity>

    </application>

</manifest>
