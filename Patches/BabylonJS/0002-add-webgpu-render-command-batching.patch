+    }
+
+    private _pushU64Max(): void {
+        this._ensureCapacity(2);
+        this._commandWords[this._commandWordCount++] = 0xffffffff;
+        this._commandWords[this._commandWordCount++] = 0xffffffff;
+    }
+}
