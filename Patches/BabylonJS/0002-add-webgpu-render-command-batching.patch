+            case WebGPURenderPassCommandOpcode.setIndexBuffer:
+                index += 8;
+                break;
+            case WebGPURenderPassCommandOpcode.drawIndexed:
+                index += 6;
+                break;
+            default:
+                throw new Error(`Unexpected opcode ${opcode} at word ${index}`);
+        }
+    }
+    return opcodes;
