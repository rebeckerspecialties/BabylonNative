+        ensureAnalysis();
+        const { candidates, stats, unresolvedHeritage, dynamicReport, external } = analysis;
+        const exclusionCounts = {};
+        const excludedList = [];
+        let qualified = 0;
+        const qualifiedByForm = { field: 0, cast: 0, path: 0, expr: 0 };
+        for (const candidate of candidates) {
+            if (!candidate.excluded.length) {
+                qualified++;
+                qualifiedByForm[candidate.form.kind]++;
+                continue;
+            }
+            const reasons = [...new Set(candidate.excluded.map((e) => e.reason))];
