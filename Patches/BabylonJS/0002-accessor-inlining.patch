+                        n.operatorToken.kind,
+                        f.createParenthesizedExpression(cloneExpression(n.right, makeReceiver))
+                    );
+                case ts.SyntaxKind.ConditionalExpression:
+                    return f.createConditionalExpression(
+                        f.createParenthesizedExpression(cloneExpression(n.condition, makeReceiver)),
+                        undefined,
+                        cloneExpression(n.whenTrue, makeReceiver),
+                        undefined,
+                        cloneExpression(n.whenFalse, makeReceiver)
