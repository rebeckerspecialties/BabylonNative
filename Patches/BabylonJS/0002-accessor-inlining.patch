+                const declaration = symbol?.valueDeclaration;
+                if (declaration && (ts.isVariableDeclaration(declaration) || ts.isParameter(declaration) || ts.isBindingElement(declaration)) && declaration.getSourceFile() === inner.getSourceFile()) {
