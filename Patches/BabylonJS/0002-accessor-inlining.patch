+        const tainted = (kind) => {
+            const list = candidates.filter((c) => c.castTaint?.[kind]);
+            return { candidates: list.length, rewrittenSites: list.reduce((sum, c) => sum + c.sites, 0) };
+        };
+        return {
+            mode: options.mode,
+            enabledForms: MODES[options.mode],
+            allowMapped: options.allowMapped,
+            total,
+            filesTouched,
+            sitesByForm,
+            sitesByReceiverKind: sitesByReceiver,
+            sitesOnClassesWithoutNominalBrand: unbrandedSites,
+            downcastPolicy: analysis.policy,
+            typeAssertions: { ...analysis.assertionStats, candidatesReachableThroughDowncast: tainted("downcast"), candidatesReachableThroughAnyCast: tainted("fromAny") },
+            sitesIfFormWereEnabled: potentialByForm,
+            getters: {
+                ...stats,
+                instanceCandidates: candidates.length,
+                qualified,
+                qualifiedByForm,
+                excludedByReason: exclusionCounts,
+            },
+            skippedSites: skipped,
+            skippedSiteSamples: samples,
+            perProp,
+            details: rewritten.map((c) => ({ key: c.key, form: c.form.kind, backing: c.expandedPath?.join(".") ?? "<expr>", where: c.where, sites: c.sites, byReceiver: c.sitesByReceiver, branded: c.branded, transitive: !!c.transitive, anyCasts: c.castTaint?.fromAny?.count ?? 0, downcasts: c.castTaint?.downcast?.count ?? 0 })),
+            excluded: excludedList,
+            unresolvedHeritage,
+            dynamicRedefinitions: dynamicReport,
+            externalPackages: external,
+            analysisMs: analysis.analysisMs,
+        };
+    };
+
+    const writeReport = () => {
+        if (!options.reportPath || !analysis) {
+            return;
+        }
+        mkdirSync(dirname(resolve(options.reportPath)), { recursive: true });
+        writeFileSync(resolve(options.reportPath), JSON.stringify(buildReport(), null, 2) + "\n", "utf8");
+    };
+
+    return { before: [factory], buildReport, writeReport };
+}
+
+let exitHookInstalled = false;
+const pendingReports = [];
+
+/**
+ * Convenience for build configurations: returns the custom transformers for `program` when the pass is switched
+ * on through the environment (undefined otherwise) and writes the report when the process exits.
+ * @param program the TypeScript program being emitted
+ * @returns custom transformers or undefined
+ */
+export function accessorInlineTransformersFromEnv(program) {
+    const options = getAccessorInlineOptionsFromEnv();
+    if (!options) {
+        return undefined;
+    }
+    const transformers = createAccessorInlineTransformers(program, options);
+    pendingReports.push(transformers);
+    if (!exitHookInstalled) {
+        exitHookInstalled = true;
+        process.on("exit", () => {
+            // The last program created is the one that was emitted.
+            pendingReports[pendingReports.length - 1]?.writeReport();
+        });
+    }
+    return { before: transformers.before };
+}
