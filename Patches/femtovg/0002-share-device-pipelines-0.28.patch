+#[derive(Debug)]
+struct DevicePipelines {
+    device: wgpu::Device,
+    shader: Rc<wgpu::ShaderModule>,
+    viewport: wgpu::BindGroupLayout,
+    layouts: [DrawLayout; 2],
+    cache: Rc<RefCell<HashMap<PipelineState, CachedPipeline>>>,
+    epoch: std::cell::Cell<u64>,
+}
+
+impl DevicePipelines {
+    fn for_device(device: &wgpu::Device) -> Rc<Self> {
+        thread_local! {
+            static ENTRIES: RefCell<Vec<std::rc::Weak<DevicePipelines>>> = const { RefCell::new(Vec::new()) };
+        }
+        ENTRIES.with_borrow_mut(|entries| {
+            entries.retain(|p| p.strong_count() != 0);
+            if let Some(p) = entries
+                .iter()
+                .filter_map(std::rc::Weak::upgrade)
+                .find(|p| p.device == *device)
+            {
+                return p;
+            }
+            let module = wgpu::ShaderModuleDescriptor {
+                label: Some("femtovg"),
+                source: wgpu::ShaderSource::Wgsl(
+                    concat!(
+                        include_str!("wgpu/shader.wgsl"),
+                        "\n",
+                        include_str!("wgpu/filters.wgsl")
+                    )
+                    .into(),
+                ),
+            };
+            let shader_module = Rc::new(device.create_shader_module(module));
+            let viewport_bind_group_layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("Bind Group Layout for Viewport uniform"),
+                entries: &[wgpu::BindGroupLayoutEntry {
+                    binding: 0,
+                    visibility: wgpu::ShaderStages::VERTEX,
+                    ty: wgpu::BindingType::Buffer {
+                        ty: wgpu::BufferBindingType::Uniform,
+                        has_dynamic_offset: false,
+                        min_binding_size: None,
+                    },
+                    count: None,
+                }],
+            });
+
+            let draw_layouts = [false, true].map(|mask| DrawLayout::new(device, &viewport_bind_group_layout, mask));
+            let p = Rc::new(Self {
+                device: device.clone(),
+                shader: shader_module,
+                viewport: viewport_bind_group_layout,
+                layouts: draw_layouts,
+                cache: Default::default(),
+                epoch: Default::default(),
+            });
+            entries.push(Rc::downgrade(&p));
+            p
+        })
+    }
+}
+
