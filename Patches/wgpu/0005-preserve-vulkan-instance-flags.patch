 [target.'cfg(all(target_arch = "wasm32", not(target_os = "emscripten")))'.dependencies]
-wgpu-core-deps-wasm = { workspace = true, optional = true }
+wgpu-core-deps-wasm = { git = "https://github.com/gfx-rs/wgpu.git", rev = "40f4a34ebaf56f9a046231f54125ad046239d3f3", optional = true }
 
 [target.'cfg(any(windows, target_os = "linux", target_os = "android", target_os = "freebsd"))'.dependencies]
-wgpu-core-deps-windows-linux-android = { workspace = true, optional = true }
+wgpu-core-deps-windows-linux-android = { git = "https://github.com/gfx-rs/wgpu.git", rev = "40f4a34ebaf56f9a046231f54125ad046239d3f3", optional = true }
 
 [dependencies]
 naga.workspace = true
 naga-types.workspace = true
-wgpu-naga-bridge.workspace = true
+wgpu-naga-bridge = { git = "https://github.com/gfx-rs/wgpu.git", rev = "40f4a34ebaf56f9a046231f54125ad046239d3f3" }
 wgpu-hal.workspace = true
-wgpu-types.workspace = true
+wgpu-types = { git = "https://github.com/gfx-rs/wgpu.git", rev = "40f4a34ebaf56f9a046231f54125ad046239d3f3", default-features = false }
 
 arrayvec.workspace = true
 bit-vec.workspace = true
