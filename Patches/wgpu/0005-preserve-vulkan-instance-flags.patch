diff --git a/wgpu-core/Cargo.toml b/wgpu-core/Cargo.toml
index 839f941b6..a9e857ee6 100644
--- a/wgpu-core/Cargo.toml
+++ b/wgpu-core/Cargo.toml
@@ -1,4 +1,5 @@
 [package]
+workspace = ".."
 name = "wgpu-core"
 version.workspace = true
 authors.workspace = true
@@ -161,23 +162,23 @@ noop = []
 # platform crates from being included in the build at a time, preventing users
 # from getting confused by seeing them in the list of crates.
 [target.'cfg(target_vendor = "apple")'.dependencies]
-wgpu-core-deps-apple = { workspace = true, optional = true }
+wgpu-core-deps-apple = { git = "https://github.com/gfx-rs/wgpu.git", rev = "40f4a34ebaf56f9a046231f54125ad046239d3f3", optional = true }
 
 [target.'cfg(target_os = "emscripten")'.dependencies]
-wgpu-core-deps-emscripten = { workspace = true, optional = true }
